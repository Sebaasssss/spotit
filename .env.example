# Copia este archivo a .env y rellena los valores. .env nunca se versiona.

# --- Django ---
# Genera una clave con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False
# Hosts separados por comas. ".trycloudflare.com" permite el túnel de pruebas en celular.
ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com
# Orígenes con esquema, separados por comas (admite comodín de subdominio).
CSRF_TRUSTED_ORIGINS=http://localhost:8080,https://*.trycloudflare.com
# Solo hace falta si el frontend se sirve desde otro origen (p. ej. Vite dev en :5173 sin proxy).
CORS_ALLOWED_ORIGINS=
# Número de workers de gunicorn (lo lee gunicorn directamente).
WEB_CONCURRENCY=2

# --- Autenticación (JWT) ---
# El access viaja en memoria del frontend; el refresh en una cookie httpOnly.
JWT_ACCESS_MINUTES=10
JWT_REFRESH_DAYS=14
# Intentos de login/registro por IP (formato DRF: N/sec|min|hour|day).
AUTH_THROTTLE_RATE=10/min
# Segundos para aceptar una vez el refresh anterior si la respuesta de rotación se perdió.
AUTH_REFRESH_GRACE_SECONDS=60
# Cookies (refresh, sesión y CSRF del admin) solo por HTTPS. En producción siempre True;
# docker-compose.override.yml lo pone en False para http://localhost:8080.
AUTH_COOKIE_SECURE=True

# --- Reportes ---
# Reportes nuevos por usuario (formato DRF: N/sec|min|hour|day).
REPORT_THROTTLE_RATE=20/hour

# --- Notificaciones push (Web Push con VAPID) ---
# Secretas: solo en el .env del servidor, nunca en el repo ni en la imagen. Genéralas con:
#   docker compose exec backend python manage.py generar_vapid
# y pega aquí las dos líneas que imprime. Si faltan, los avisos quedan desactivados.
# Cambiarlas invalida las suscripciones: cada teléfono debe volver a activar los avisos.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto para los servicios de push: mailto:alguien@tu-dominio o una URL https.
VAPID_SUBJECT=

# --- Mapa (frontend; se incrusta en el build, no pongas secretos) ---
# Centro del mapa cuando no hay GPS. Formato exacto: latitud,longitud,zoom
#   latitud  : decimal entre -90 y 90, con punto decimal
#   longitud : decimal entre -180 y 180, con punto decimal
#   zoom     : entero entre 3 y 19
# Separados por comas y sin espacios. Si falta o es inválido, la app usa la Ciudad de México.
VITE_MAPA_CENTRO=19.432608,-99.133209,12
# Ejemplo (un campus):
# VITE_MAPA_CENTRO=18.8502834,-99.2007355,16

# --- PostgreSQL ---
POSTGRES_USER=spotit
POSTGRES_PASSWORD=
POSTGRES_DB=spotit
# Debe coincidir con los valores de arriba. "db" es el nombre del servicio en el compose.
DATABASE_URL=postgres://spotit:CAMBIA_ESTA_CLAVE@db:5432/spotit

# --- nginx ---
# Puerto del host donde se publica nginx (el único servicio expuesto).
HTTP_PORT=8080

# --- Solo desarrollo (docker-compose.override.yml), ligados a 127.0.0.1 ---
DB_HOST_PORT=5433
BACKEND_HOST_PORT=8000
